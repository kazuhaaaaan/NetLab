{
  "$schema": "https://typedoc.org/schema.json",
  "name": "NetLab Public API (@mikrolab/*)",
  "entryPoints": ["packages/*/src/index.ts"],
  "entryPointStrategy": "expand",
  "out": "docs/api",
  "tsconfig": "tsconfig.json",
  "readme": "none",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true
}
