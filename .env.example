# GEMINI_API_KEY: Wajib untuk jawaban AI bebas di panel chat (server/index.mjs).
# Ambil gratis di https://aistudio.google.com/apikey — salin ke file .env (bukan ini).
# Tanpa key, panel chat jatuh ke AI lokal rule-based dan terminal tetap berjalan normal.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model Gemini yang dipakai server AI. Default gemini-3.5-flash.
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: URL tempat aplikasi di-host (mis. server Node Anda di production).
# AI Studio otomatis mengisi ini di runtime; dipakai klien LLM untuk panggilan /api/ai
# bila aplikasi tidak diproksi (dev memakai vite proxy ke port AI_PORT).
APP_URL="MY_APP_URL"

# AI_PORT: Port server MikroAi (server/index.mjs) dan proxy vite /api.
# Opsional — default 8787.
AI_PORT=8787
