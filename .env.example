# ── Server AI (server/index.mjs — proxy Gemini) ────────────────────────────
# GEMINI_API_KEY: Satu-satunya tempat key Gemini yang aman untuk PRODUKSI —
# tinggal server-side, tidak pernah dikirim ke browser.
# Ambil gratis di https://aistudio.google.com/apikey — salin ke file .env (bukan ini).
# Tanpa key, panel chat jatuh ke AI lokal rule-based dan terminal tetap berjalan normal.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model Gemini yang dipakai server AI. Default gemini-3.5-flash
# (gemini-2.5-flash sudah 404 untuk user baru).
GEMINI_MODEL="gemini-3.5-flash"

# ALLOWED_ORIGINS: daftar origin (dipisah koma) yang boleh memanggil /api/ai.
# WAJIB di-set di produksi, mis.:
#   ALLOWED_ORIGINS=https://netlab.kazudev.my.id
# Tanpa ini server memakai daftar dev (localhost) dan situs produksi akan
# diblokir CORS (fail-closed). Server memberi peringatan saat NODE_ENV=production.
ALLOWED_ORIGINS="https://netlab.kazudev.my.id"

# TRUST_PROXY: set "1" HANYA bila server berjalan di belakang reverse proxy
# tepercaya yang menimpa header X-Forwarded-For (nginx/caddy/cloudflare).
# Tanpa ini, rate limit memakai alamat socket (header klien tidak dipercaya).
TRUST_PROXY=0

# Rate limit per-IP (sliding window). Default: 20 request / 60 detik.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000

# AI_TIMEOUT_MS: batas waktu panggilan upstream Gemini. Default 30000.
AI_TIMEOUT_MS=30000

# AI_PORT: Port server MikroAi (server/index.mjs) dan proxy vite /api.
# Opsional — default 8787.
AI_PORT=8787

# ── MODE LANGSUNG (development SAJA — TIDAK AMAN untuk publik) ─────────────
# VITE_GEMINI_API_KEY: bila diisi, chat memanggil Gemini langsung dari browser.
# Hanya aktif saat "npm run dev" (guard DEV): key ini TIDAK PERNAH masuk bundle
# produksi. JANGAN set key ini di CI/production — bundle akan mengandung key
# publik yang bisa disalahgunakan (pencurian kuota/biaya).
# Bila kosong (atau saat build produksi), dipakai mode server GEMINI_API_KEY di atas.
# VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_MODEL: Model untuk mode langsung (dev). Default gemini-3.5-flash.
# VITE_GEMINI_MODEL="gemini-3.5-flash"

# APP_URL: URL aplikasi (mis. server Node production). Dipakai klien LLM untuk
# memanggil /api/ai bila aplikasi tidak diproksi; dev memakai vite proxy ke AI_PORT.
# APP_URL="MY_APP_URL"

# ── DEPLOY VERCEL (disarankan: semua di satu origin) ────────────────────────
# Frontend + proxy /api/ai di Vercel: repo ini di-import ke Vercel, domain
# (netlab.kazudev.my.id) dipasang di dashboard. Frontend memanggil /api/ai
# relatif — TANPA APP_URL dan TANPA ALLOWED_ORIGINS (same-origin, tidak CORS).
# Cukup set dua env ini di Vercel → Project → Settings → Environment Variables:
#   GEMINI_API_KEY=<key Gemini>   # wajib; TIDAK pernah masuk bundle frontend
#   TRUST_PROXY=1                 # agar rate limit memakai IP asli pengunjung
# Opsional: GEMINI_MODEL, RATE_LIMIT_REQUESTS, RATE_LIMIT_WINDOW_MS.
# Note: rate limit in-memory bersifat per-instance serverless.